# AI Coding HTML Hosting Platform — Environment Configuration
# Copy this file to .env and fill in your values

# Environment: "development" or "production"
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/htmlhost

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Encryption key for stored API keys (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# LLM Platform Defaults (user can override in Settings page)
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com

# Common LLM base URLs:
# DeepSeek:  https://api.deepseek.com
# Qwen (阿里云百炼): https://dashscope.aliyuncs.com/compatible-mode/v1
# OpenAI:    https://api.openai.com/v1
# SiliconFlow: https://api.siliconflow.cn/v1

# API Proxy
PROXY_ALLOWED_DOMAINS=api.openweathermap.org,api.github.com,restapi.amap.com
PROXY_WHITELIST_MODE=open

# App
PUBLIC_BASE_URL=http://localhost:8000
