# 复制为 .env 并填写：cp .env.example .env
# ⚠️ 本文件不含真实密钥；.env 已被 gitignore，绝不提交。

# ── 数据库 ──
# 本地开发默认即可；docker compose 下会被覆盖为 volume 内路径，此值不生效
DATABASE_URL=sqlite+aiosqlite:///./htmlhost.db

# ── JWT ──
# 生产必须改成随机长字符串：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── 用户级 LLM 配置加密密钥 ──
# 生产必须换成随机值：python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=change-me

# ── 平台默认 LLM ──
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# ── API 代理网关白名单 ──
# 逗号分隔的允许域名；WHITELIST_MODE: open=不限制 / whitelist=仅白名单
PROXY_ALLOWED_DOMAINS=
PROXY_WHITELIST_MODE=open

# ── 管理员 ──
# 逗号分隔的 user_id 列表
ADMIN_USER_IDS=demo
